{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--category-experimental-webmcp",
        "--auto-connect"
      ],
      "directTools": [
        "list_pages",
        "select_page",
        "list_webmcp_tools",
        "execute_webmcp_tool"
      ]
    }
  }
}
